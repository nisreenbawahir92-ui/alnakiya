# Public site URL (use your live domain in production)
NEXT_PUBLIC_SITE_URL=https://alnakiyatrading.com

# Optional: public URL for catalog PPT (e.g. Supabase Storage) when file is too large to deploy
# NEXT_PUBLIC_CATALOG_DOWNLOAD_URL=https://YOUR_PROJECT.supabase.co/storage/v1/object/public/catalog/Nakiya-Product-Catalog-Complete.pptx
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Public bucket for site images/videos (create in Supabase → Storage → New bucket → Public)
NEXT_PUBLIC_MEDIA_BUCKET=site-media
